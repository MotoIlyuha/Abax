# Настройки сервера Abax (переменные окружения). Запуск: npm run server
PORT=8787
HOST=127.0.0.1
# Каталог данных: abax.db, assets/, jwt-secret (в разработке создаётся сам)
DATA_DIR=.data
# Секрет подписи сессий. В продакшене обязателен: openssl rand -hex 32
JWT_SECRET=
# Токен бота для входа через Telegram (oauth.telegram.org; домен клиента задаётся боту в BotFather /setdomain); пусто — вход отключён
TELEGRAM_BOT_TOKEN=
# Вход через Google (OAuth 2.0, Authorization Code + PKCE). Redirect URI: <PUBLIC_API_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Адрес самого API (для redirect URI Google); пусто — из заголовка Host запроса
PUBLIC_API_URL=
# Дополнительные адреса веб-клиента (через запятую), куда можно вернуть пользователя после входа
ALLOWED_ORIGINS=
# Почта для кодов входа: HTTP-webhook (POST JSON {to, subject, text}) или SMTP. Пусто — вход по почте выключен
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_TOKEN=
SMTP_HOST=
SMTP_PORT=587
# 1 — TLS сразу (порт 465); иначе STARTTLS, если сервер его предлагает
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Abax <no-reply@example.com>
# 1 — dev-провайдеры входа (код почты в ответе, тестовые Telegram/Google). Никогда не включайте в продакшене
ABAX_DEV_AUTH=
# Адрес веб-клиента для ссылок-приглашений
PUBLIC_WEB_URL=https://motoilyuha.github.io/Abax
# 1 — серверные лимиты тарифов действуют (до запуска платежей оставьте пустым)
ABAX_ENFORCE_LIMITS=
# Каталог собранного клиента (dist), если сервер раздаёт и его
STATIC_DIR=
# 1 — сервер за nginx/Caddy: адрес клиента из X-Forwarded-For
TRUST_PROXY=
# S3-совместимое хранилище картинок (Yandex Object Storage, Timeweb Cloud); пусто — файлы в DATA_DIR/assets
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=ru-central1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

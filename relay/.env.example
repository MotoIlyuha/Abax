# Домен ретранслятора: A-запись (и AAAA, если есть IPv6) должна указывать на этот сервер.
RELAY_DOMAIN=relay.example.com
# Откуда гости открывают доску (GitHub Pages). Пусто — пускать гостей с любых страниц.
RELAY_ALLOWED_ORIGINS=https://motoilyuha.github.io
# На сервере с 1 ГБ памяти очередь на одного участника лучше уменьшить до 16 МиБ
# (и добавить подкачку на 1–2 ГБ): медленный гость с большой доской не съест всю память.
# RELAY_MAX_BUFFER=16777216

{
  "name": "doska",
  "version": "2.3.0",
  "private": true,
  "description": "Локальная доска для занятий по математике",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "app:dev": "node scripts/electron-dev.mjs",
    "icons": "node scripts/icons.mjs",
    "emoji": "node scripts/emoji.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "electron": "electron .",
    "dist": "npm run build && electron-builder --win nsis portable",
    "collab:demo": "node scripts/collab-demo.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck:tests && npm run test && npm run test:e2e",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@playwright/test": "1.56.1",
    "@vitest/coverage-v8": "^3.2.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "emojibase-data": "16.0.3",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@types/ws": "^8.18.2",
    "pdfjs-dist": "^4.10.38",
    "ws": "^8.22.0"
  }
}

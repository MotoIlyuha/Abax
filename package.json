    "@vitest/coverage-v8": "^3.2.4",
    "better-sqlite3": "^13.2.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "emojibase-data": "16.0.3",
    "esbuild": "^0.21.5",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@types/ws": "^8.18.2",
    "pdfjs-dist": "^4.10.38",
    "ws": "^8.22.0"
  }

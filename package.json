  "private": true,
  "description": "Локальная доска для занятий по математике",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:cloud": "node scripts/dev-cloud.mjs",
    "app:dev": "node scripts/electron-dev.mjs",
    "icons": "node scripts/icons.mjs",
    "emoji": "node scripts/emoji.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "electron": "electron .",
    "dist": "npm run build && electron-builder --win nsis portable",
    "collab:demo": "node scripts/collab-demo.mjs",
    "relay": "node relay/index.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck:tests && npm run test && npm run test:e2e",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "server:build": "esbuild server/index.ts server/plan-cli.ts server/promo-cli.ts --bundle --platform=node --format=esm --packages=external --target=node22 --outdir=dist-server --out-extension:.js=.mjs --log-level=warning",
    "server": "npm run server:build && node dist-server/index.mjs",
    "server:plan": "npm run server:build && node dist-server/plan-cli.mjs",
    "server:promo": "npm run server:build && node dist-server/promo-cli.mjs"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",

{
  "name": "doska",
  "version": "1.1.0",
  "private": true,
  "description": "Локальная доска для занятий по математике",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "app:dev": "node scripts/electron-dev.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "electron": "electron .",
    "dist": "npm run build && electron-builder --win nsis portable",
    "collab:demo": "node scripts/collab-demo.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@types/ws": "^8.18.2",
    "pdfjs-dist": "^4.10.38",
    "ws": "^8.22.0"
  }
}
